<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>WalkTracker</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>

	<!-- Permission strings. These are what App Review reads and what the
	     person sees in the system dialog, so each one says what is collected,
	     what it is used for, and what is lost by saying no. -->

	<key>NSLocationWhenInUseUsageDescription</key>
	<string>WalkTracker uses your location while you have a walk running to work out which streets you covered, and fills them in on your map of the city. Your location history is stored only on this device: there is no account, and nothing is uploaded.</string>

	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>WalkTracker needs background location so it can keep recording your route while your phone is in your pocket or the screen is off. Without it, a walk is only recorded while the app is on screen, and the streets you cover in between are lost. Recording only ever runs during a walk you start yourself, the blue location indicator stays visible the whole time, and your location history never leaves this device.</string>

	<key>NSMotionUsageDescription</key>
	<string>WalkTracker uses motion activity to tell walking apart from riding, so that a bus or taxi trip down a street is not counted as a street you walked. It is used only to decide whether a stretch of a route counts toward your coverage, and it is never stored or uploaded.</string>

	<!-- Background execution. The location mode is what keeps CoreLocation
	     delivering fixes while the app is suspended; it is also what makes
	     CLLocationManager.allowsBackgroundLocationUpdates legal to set. No
	     other background mode is declared, because no other one is used. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
	</array>

	<!-- The app uses no encryption beyond Apple-provided TLS and the platform
	     hashing in CryptoKit, both of which are exempt. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>

	<!-- Empty dictionary means the modern storyboard-free launch screen: a
	     plain window in the system background colour. -->
	<key>UILaunchScreen</key>
	<dict/>

	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>

	<!-- location-services rather than gps: a Wi-Fi only iPad can still show
	     your coverage map and manage city packs. -->
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
		<string>location-services</string>
	</array>
</dict>
</plist>
